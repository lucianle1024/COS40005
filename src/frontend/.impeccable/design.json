  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Local findings action.",
      "html": "<button class=\"ds-primary\">Finalise findings <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"></path></svg></button>",
      "css": ".ds-primary{font-family:'Segoe UI','Helvetica Neue',system-ui,sans-serif;font-size:12px;font-weight:600;line-height:1.4;cursor:pointer;transition:background .15s,color .15s,border-color .15s;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:38px;padding:8px 12px;border:1px solid #047857;border-radius:6px;background:var(--green,#047857);color:#fff}.ds-primary:hover{background:#065f46;border-color:#065f46}.ds-primary:focus-visible{outline:2px solid #059669;outline-offset:3px}.ds-primary:active{transform:translateY(1px)}.ds-primary:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Explicit draft save action.",
      "html": "<button class=\"ds-secondary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 3h14l3 3v15H3V3zM7 3v6h10V3M7 21v-8h10v8\"></path></svg> Save draft</button>",
      "css": ".ds-secondary{font-family:'Segoe UI','Helvetica Neue',system-ui,sans-serif;font-size:12px;font-weight:600;line-height:1.4;cursor:pointer;transition:background .15s,color .15s,border-color .15s;display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:8px 12px;border:1px solid #cbd5e1;border-radius:6px;background:#f1f5f9;color:#1e293b}.ds-secondary:hover{background:#e2e8f0}.ds-secondary:focus-visible{outline:2px solid #059669;outline-offset:3px}.ds-secondary:active{transform:translateY(1px)}.ds-secondary:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}.ds-secondary{gap:7px}"
    },
    {
      "name": "Command button",
      "kind": "button",
      "refersTo": "button-command",
      "description": "Secondary action on the dark command bar.",
      "html": "<div class=\"ds-command-surface\"><button class=\"ds-command\">Case brief</button></div>",
      "css": ".ds-command-surface{padding:10px;background:var(--ink,#0f172a)}.ds-command{font-family:'Segoe UI','Helvetica Neue',system-ui,sans-serif;font-size:12px;font-weight:600;line-height:1.4;cursor:pointer;transition:background .15s,color .15s,border-color .15s;min-height:32px;padding:5px 9px;border:1px solid #3b4a60;border-radius:5px;background:#1e293b;color:#e2e8f0;font-size:11px}.ds-command:hover{background:#334155}.ds-command:focus-visible{outline:2px solid #059669;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-command{transition:none}}"
    },
    {
      "name": "Reasoning field",
      "kind": "input",
      "refersTo": "input-findings",
      "description": "Editable analyst reasoning.",
      "html": "<label class=\"ds-field\">Your reasoning<textarea class=\"ds-reasoning\" placeholder=\"Explain what the evidence supports.\"></textarea></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;font-family:'Segoe UI','Helvetica Neue',system-ui,sans-serif;font-size:12px;font-weight:600;color:#1e293b}.ds-reasoning{width:100%;padding:10px;min-height:130px;height:146px;resize:vertical;border:1px solid #cbd5e1;border-radius:6px;background:var(--paper,#fff);color:var(--ink,#0f172a);font-family:'Segoe UI','Helvetica Neue',system-ui,sans-serif;font-size:12px;font-weight:400;line-height:1.7}.ds-reasoning::placeholder{color:#64748b}.ds-reasoning:focus{border-color:#059669}.ds-reasoning:focus-visible{outline:2px solid #059669;outline-offset:3px}.ds-reasoning:disabled{background:#f1f5f9;color:#475569;opacity:1}"
    },
    {
      "name": "Workflow mode navigation",
      "kind": "nav",
      "refersTo": "button-command",
      "description": "Three visible workflow choices; combined shown selected.",
      "html": "<div class=\"ds-modes\" role=\"group\" aria-label=\"Workflow mode\"><button aria-pressed=\"false\">Human only</button><button aria-pressed=\"false\">AI only</button><button aria-pressed=\"true\">Human + AI</button></div>",
      "css": ".ds-modes{display:flex;gap:2px;padding:3px;background:#020617;border:1px solid #334155;border-radius:7px}.ds-modes button{font-family:'Segoe UI','Helvetica Neue',system-ui,sans-serif;font-size:12px;font-weight:600;line-height:1.4;cursor:pointer;transition:background .15s,color .15s,border-color .15s;min-height:32px;padding:6px 9px;border:1px solid transparent;border-radius:4px;background:transparent;color:#cbd5e1;font-size:11px;font-weight:500}.ds-modes button:hover{background:#1e293b;color:#fff}.ds-modes button[aria-pressed=\"true\"]{background:var(--green,#047857);border-color:#059669;color:#fff}.ds-modes button[aria-pressed=\"true\"]:hover{background:#065f46}.ds-modes button:focus-visible{outline:2px solid #059669;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-modes button{transition:none}}"
    },
    {
      "name": "Cited source control",
      "kind": "chip",
      "refersTo": "button-primary",
      "description": "Citation selection; this does not verify a record.",
      "html": "<button class=\"ds-cite\" aria-pressed=\"true\" aria-label=\"Cited E01: remove citation\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"></path></svg> Cited</button>",
      "css": ".ds-cite{font-family:'Segoe UI','Helvetica Neue',system-ui,sans-serif;font-size:12px;font-weight:600;line-height:1.4;cursor:pointer;transition:background .15s,color .15s,border-color .15s;display:inline-flex;align-items:center;gap:5px;min-height:32px;padding:5px 9px;border:1px solid #047857;border-radius:5px;background:var(--green,#047857);color:#fff;font-size:11px}.ds-cite:hover{background:#047857}.ds-cite:focus-visible{outline:2px solid #059669;outline-offset:3px}.ds-cite:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-cite{transition:none}}"
    },
    {
      "name": "Evidence tile",
      "kind": "card",
      "refersTo": "record-active",
      "description": "Active record identity and independent citation action; compact horizontal actions on short desktop viewports.",
      "html": "<div class=\"ds-tile\"><button class=\"ds-open\" aria-pressed=\"true\"><span class=\"ds-record-id\">E01</span><span class=\"ds-summary\"><strong>Message headers</strong><span class=\"ds-time\">Email / 09:12:04 UTC</span></span></button><button class=\"ds-tile-cite\" aria-pressed=\"false\" aria-label=\"Cite E01 as supporting evidence\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6\"></path></svg> Cite</button></div>",
      "css": ".ds-tile{max-width:220px;border:1px solid #0f172a;border-radius:7px;background:var(--ink,#0f172a);overflow:hidden;font-family:'Segoe UI','Helvetica Neue',system-ui,sans-serif}.ds-open{font-family:'Segoe UI','Helvetica Neue',system-ui,sans-serif;font-size:12px;font-weight:600;line-height:1.4;cursor:pointer;transition:background .15s,color .15s,border-color .15s;display:flex;flex-direction:column;align-items:flex-start;gap:5px;min-height:67px;padding:8px;border:0;background:transparent;color:#6ee7b7;text-align:left;width:100%;font-size:11px}.ds-open strong{color:#fff;font-size:11px;font-weight:600}.ds-record-id{font-family:var(--font-mono,'Cascadia Code','SFMono-Regular',Consolas,monospace);font-weight:650}.ds-time{font-size:9.5px;color:#b7c5d6}.ds-open:hover{background:#1e293b}.ds-open:focus-visible,.ds-tile-cite:focus-visible{outline:2px solid #059669;outline-offset:3px}.ds-tile-cite{font-family:'Segoe UI','Helvetica Neue',system-ui,sans-serif;font-size:12px;font-weight:600;line-height:1.4;cursor:pointer;transition:background .15s,color .15s,border-color .15s;min-height:28px;margin:0 8px 8px;padding:3px 7px;border:1px solid #475569;border-radius:5px;background:#1e293b;color:#e2e8f0;font-size:10px}.ds-tile-cite:hover{background:#1e293b}@media(prefers-reduced-motion:reduce){.ds-open,.ds-tile-cite{transition:none}}.ds-tile-cite{display:inline-flex;align-items:center;gap:5px}@media(min-width:1024px) and (min-height:600px) and (max-height:700px){.ds-tile{display:flex;flex-direction:row;align-items:center}.ds-open{flex:1;flex-direction:row;align-items:center;gap:5px;min-height:46px;padding:6px;min-width:0}.ds-tile-cite{flex-shrink:0;align-self:center;min-height:28px;padding:4px;margin:4px 4px 4px 0}.ds-tile-cite svg{display:none}.ds-open strong,.ds-time{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}}.ds-summary{display:flex;flex-direction:column;gap:3px;width:100%;min-width:0}.ds-record-id{flex-shrink:0}"
    },
    {
      "name": "Decision panel",
      "kind": "card",
